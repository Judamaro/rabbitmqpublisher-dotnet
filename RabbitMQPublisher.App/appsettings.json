{
  "ConnectionStrings": {
    "PublisherMessage": "ConnectionStrings_Postgres_PublisherMessage"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "RabbitMQOptions": {
    "Name": "RabbitMQOptions_Name",
    "Host": "RabbitMQOptions_Host",
    "User": "RabbitMQOptions_User",
    "Pwd": "RabbitMQOptions_Pwd",
    "Queue": "RabbitMQOptions_Queue",
    "Port": 5672,
    "VirtualHost": "/",
    "PrefetchCount": 10,
    "HeartbeatSeconds": 30,
    "NetworkRecoveryIntervalSeconds": 5,
    "MaxConnectRetryDelaySeconds": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "RabbitMQPublisher"
    }
  },
  "AllowedHosts": "*"
}
